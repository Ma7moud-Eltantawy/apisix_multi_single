# ==============================================================================
# 🌐 QYADATI APISIX - MULTI-FLAVOR ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# نموذج افتراضي لملف متغيرات البيئة لمنظومة Qyadati APISIX Gateway.
# للبدء: قم بنسخ هذا الملف إلى `.env` وعدّل القيم بحسب البيئة المستهدفة:
#   PowerShell: Copy-Item .env.example .env
#   Bash      : cp .env.example .env
#
# البيئات الخمس المدعومة (5 Supported Flavors):
#   1. Desktop      : بيئة التطوير الشخصية (Docker Desktop / localhost)
#   2. Local Server : سيرفر الشبكة الداخلية بمقر الشركة (On-Premise LAN)
#   3. Dev Server   : سيرفر التطوير السحابي المشترك (Cloud Dev)
#   4. Staging      : سيرفر اختبارات الجودة والتكامل (QA / UAT)
#   5. Production   : سيرفر الإنتاج الفعلي المحمي في AWS VPC
# ==============================================================================

# ------------------------------------------------------------------------------
# 🎯 1. Active Environment Flavor (البيئة النشطة الحالية)
# ------------------------------------------------------------------------------
# يحدد البيئة المستهدفة للأدوات المحلية، لوحة التحكم GUI، وسكربتات المزامنة التلقائية (sync / test).
# الخيارات المتاحة: desktop | local | dev | staging | prod
ACTIVE_FLAVOR=desktop


# ------------------------------------------------------------------------------
# 🏗️ 2. Host & Container Naming (اسم المضيف وبادئة الحاويات)
# ------------------------------------------------------------------------------
# عنوان المضيف المحلي للبوابة (Local Host Address)
APISIX_HOST=localhost

# بادئة موحدة لأسماء حاويات Docker لتجنب تعارض الأسماء
CONTAINER_PREFIX=qyadati_apisix


# ------------------------------------------------------------------------------
# 🔐 3. Authentication & Security Secrets (المصادقة والمفاتيح السرية)
# ------------------------------------------------------------------------------
# مفتاح المصادقة الإداري (Admin API Token) للتحكم في بوابة APISIX
# ⚠️ تحذير: استبدل هذه القيمة بتوكن قوي ومعقد قبل النشر في الإنتاج
ADMIN_KEY=your_apisix_admin_token_here_change_in_production

# بيانات تسجيل الدخول إلى لوحة تحكم APISIX Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASS=AdminQyadati2026

# الرمز التعريفي لعنقود etcd الداخلي
ETCD_CLUSTER_TOKEN=qyadati-apisix-etcd-cluster


# ------------------------------------------------------------------------------
# 🔌 4. Service Ports (منافذ الشبكة والخدمات)
# ------------------------------------------------------------------------------
# منفذ حركة مرور الـ HTTP للبوابة (Data Plane Traffic)
APISIX_HTTP_PORT=9280

# منفذ حركة مرور الـ HTTPS المشفرة للبوابة (Data Plane Traffic)
APISIX_HTTPS_PORT=9444

# منفذ واجهة برمجة التطبيقات الإدارية المباشرة (Control Plane / Admin API & /ui/)
APISIX_ADMIN_PORT=9181

# المنفذ العام للوحة التحكم
DASHBOARD_PORT=9002

# منفذ لوحة تحكم Apache APISIX Dashboard الداخلي
CLASSIC_DASHBOARD_PORT=9022

# منفذ بروكسي الإدارة الموحد الرئيسي (Unified Admin Proxy عبر Port 9012)
ADMIN_PROXY_PORT=9012

# منفذ اتصال العملاء بقاعدة بيانات etcd (Client Port)
ETCD_CLIENT_PORT=2381

# منفذ الاتصال الداخلي بين عقد etcd التبادلية (Peer Port)
ETCD_PEER_PORT=2382


# ------------------------------------------------------------------------------
# 📦 5. Docker Images & Versions (إصدارات وصور Docker)
# ------------------------------------------------------------------------------
# صورة بوابة Apache APISIX
APISIX_IMAGE=apache/apisix:latest

# صورة قاعدة بيانات etcd الموزعة
ETCD_IMAGE=quay.io/coreos/etcd:v3.5.13

# صورة لوحة التحكم الرسمية APISIX Dashboard
DASHBOARD_IMAGE=apache/apisix-dashboard:latest

# صورة سيرفر Nginx لبروكسي الإدارة الموحد
ADMIN_PROXY_IMAGE=nginx:alpine


# ------------------------------------------------------------------------------
# ⚙️ 6. ADC Tool Configuration (أداة APISIX Declarative CLI)
# ------------------------------------------------------------------------------
# إصدار أداة ADC المستخدمة لفحص ومزامنة الإعدادات التصريحية
ADC_VERSION=v0.9.0

# نوع البوابة المستهدفة لأداة ADC
ADC_BACKEND=apisix


# ------------------------------------------------------------------------------
# 🗺️ 7. Environment Flavors Config & Endpoints (إعدادات ومسارات البيئات الخمس)
# ------------------------------------------------------------------------------

# --- [A] Desktop Flavor (بيئة المطور الشخصية / Docker Desktop) ---
DESKTOP_APISIX_ADMIN_URL=http://localhost:9181
DESKTOP_APISIX_ADMIN_TOKEN=your_desktop_admin_token_here
DESKTOP_CONFIG_FILE=configs/flavors/desktop/apisix.yaml

# --- [B] Local Server Flavor (سيرفر الشبكة الداخلية On-Premise LAN) ---
LOCAL_APISIX_ADMIN_URL=http://192.168.1.50:9181
LOCAL_APISIX_ADMIN_TOKEN=your_local_server_admin_token_here
LOCAL_CONFIG_FILE=configs/flavors/local/apisix.yaml

# --- [C] Dev Server Flavor (سيرفر التطوير السحابي المشترك) ---
DEV_APISIX_ADMIN_URL=https://dev-apisix.qyadati.internal:9181
DEV_APISIX_ADMIN_TOKEN=your_dev_admin_token_here
DEV_CONFIG_FILE=configs/flavors/dev/apisix.yaml

# --- [D] Staging Flavor (سيرفر اختبارات الجودة والتكامل QA / UAT) ---
STAGING_APISIX_ADMIN_URL=https://staging-apisix.qyadati.internal:9181
STAGING_APISIX_ADMIN_TOKEN=your_staging_admin_token_here
STAGING_CONFIG_FILE=configs/flavors/staging/apisix.yaml

# --- [E] Production Flavor (سيرفر الإنتاج الفعلي - AWS VPC) ---
PROD_APISIX_ADMIN_URL=https://prod-apisix.qyadati.internal:9181
PROD_APISIX_ADMIN_TOKEN=your_production_admin_token_here
PROD_CONFIG_FILE=configs/flavors/prod/apisix.yaml
